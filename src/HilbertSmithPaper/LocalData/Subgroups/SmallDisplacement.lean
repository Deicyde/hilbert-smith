import Mathlib

/-!
# Uniformly small displacement near the identity

For a group `G` with a topology acting jointly continuously on `M` (no continuity of the group
operations is assumed), an open partial homeomorphism `e : M → ℝⁿ`, a compact `C ⊆ e.source` and
`δ > 0`, elements near the identity keep `C` in `e.source` and move it by less than `δ` in the
chart. The additive version (for `ℤ_[p]`) is generated by `to_additive`.
-/

open scoped Topology

namespace HSP

/-- Elements near the identity move a compact subset of a chart domain little, measured in the
chart. -/
@[to_additive /-- Additive version: elements near `0` move a compact subset of a chart domain
little, measured in the chart. -/]
theorem exists_nhds_one_small_displacement {G M : Type*} {n : ℕ} [TopologicalSpace G] [Group G]
    [TopologicalSpace M] [MulAction G M] [ContinuousSMul G M]
    (e : OpenPartialHomeomorph M (EuclideanSpace ℝ (Fin n))) {C : Set M} (hC : IsCompact C)
    (hCe : C ⊆ e.source) {δ : ℝ} (hδ : 0 < δ) :
    ∃ V ∈ 𝓝 (1 : G), ∀ g ∈ V, ∀ x ∈ C, g • x ∈ e.source ∧ dist (e (g • x)) (e x) < δ := by
  set O : Set (G × M) := Prod.snd ⁻¹' e.source ∩ (fun q => q.1 • q.2) ⁻¹' e.source with hO
  have hOo : IsOpen O := (e.open_source.preimage continuous_snd).inter
    (e.open_source.preimage continuous_smul)
  have hcont : ContinuousOn (fun q : G × M => dist (e (q.1 • q.2)) (e q.2)) O := by
    refine continuous_dist.comp_continuousOn (ContinuousOn.prodMk ?_ ?_)
    · exact e.continuousOn.comp continuous_smul.continuousOn fun q hq => hq.2
    · exact e.continuousOn.comp continuous_snd.continuousOn fun q hq => hq.1
  have hS := hcont.isOpen_inter_preimage hOo (isOpen_Iio (a := δ))
  have hsub : ({1} : Set G) ×ˢ C ⊆
      O ∩ (fun q : G × M => dist (e (q.1 • q.2)) (e q.2)) ⁻¹' Set.Iio δ := by
    rintro ⟨g, x⟩ ⟨hg, hx⟩
    simp only [Set.mem_singleton_iff] at hg
    subst hg
    simpa [hO, hCe hx] using hδ
  obtain ⟨u, v, hu, -, h1u, hCv, huv⟩ := generalized_tube_lemma isCompact_singleton hC hS hsub
  refine ⟨u, hu.mem_nhds (h1u rfl), fun g hg x hx => ?_⟩
  have := huv (Set.mk_mem_prod hg (hCv hx))
  exact ⟨this.1.2, this.2⟩

end HSP
