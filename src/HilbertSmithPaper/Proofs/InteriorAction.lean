import HilbertSmithPaper.Proofs.IntrinsicInterior
import HilbertSmithPaper.Proofs.IntrinsicInteriorInvariant

/-!
# The action on the intrinsic interior

If a group `G` acts on `M` and each element acts by a continuous map (`ContinuousConstSMul`), each
element acts by a homeomorphism (`Homeomorph.smul`), which maps `M°ₙ` onto itself by invariance;
so the action restricts to `M°ₙ`. The additive version (for `AddAction`, used for `ℤ_[p]`) is
generated by `to_additive`.
-/

namespace HSP

/-- Each element of `G` maps the intrinsic interior into itself. -/
@[to_additive /-- Each element of `G` maps the intrinsic interior into itself. -/]
private theorem smul_mem_intrinsicInterior {n : ℕ} {G M : Type*} [Group G] [TopologicalSpace M]
    [MulAction G M] [ContinuousConstSMul G M] (g : G) {x : M} (hx : x ∈ intrinsicInterior n M) :
    g • x ∈ intrinsicInterior n M := by
  rw [← image_intrinsicInterior n (Homeomorph.smul g)]
  exact ⟨x, hx, rfl⟩

/-- The action of `G` on `M°ₙ`: `g • x` is `g • x` computed in `M`, which lies in `M°ₙ`. -/
@[to_additive /-- The action of `G` on `M°ₙ`: `g +ᵥ x` is `g +ᵥ x` computed in `M`, which lies
in `M°ₙ`. -/]
instance intrinsicInterior.mulAction {n : ℕ} {G M : Type*} [Group G] [TopologicalSpace M]
    [MulAction G M] [ContinuousConstSMul G M] : MulAction G (intrinsicInterior n M) where
  smul g x := ⟨g • (x : M), smul_mem_intrinsicInterior g x.2⟩
  one_smul x := Subtype.ext (one_smul G (x : M))
  mul_smul g h x := Subtype.ext (mul_smul g h (x : M))

/-- The action on `M°ₙ` is computed in `M`. -/
@[to_additive (attr := simp) /-- The action on `M°ₙ` is computed in `M`. -/]
theorem intrinsicInterior.coe_smul {n : ℕ} {G M : Type*} [Group G] [TopologicalSpace M]
    [MulAction G M] [ContinuousConstSMul G M] (g : G) (x : intrinsicInterior n M) :
    ((g • x : intrinsicInterior n M) : M) = g • (x : M) :=
  rfl

end HSP
