import HilbertSmithPaper.Proofs.InteriorAction
import HilbertSmithPaper.Proofs.IntrinsicInteriorDense

/-!
# The restricted action is faithful

If `g` and `g'` agree on `M°ₙ`, the continuous maps `x ↦ g • x` and `x ↦ g' • x` into the
Hausdorff space `M` agree on a dense set, hence everywhere, so `g = g'` by faithfulness on `M`.
The additive version is generated by `to_additive`.
-/

namespace HSP

/-- For `n ≥ 1`, a Hausdorff space `M` with an atlas on the half-space `{x ∈ ℝⁿ | x 0 ≥ 0}` and a
faithful action of a group `G` on `M` by continuous maps, the restricted action on `M°ₙ` is
faithful. -/
@[to_additive /-- For `n ≥ 1`, a Hausdorff space `M` with an atlas on the half-space and a
faithful additive action of `G` on `M` by continuous maps, the restricted action on `M°ₙ` is
faithful. -/]
theorem faithfulSMul_intrinsicInterior {n : ℕ} [NeZero n] {G M : Type*} [Group G]
    [TopologicalSpace M] [T2Space M] [ChartedSpace (EuclideanHalfSpace n) M] [MulAction G M]
    [ContinuousConstSMul G M] [FaithfulSMul G M] : FaithfulSMul G (intrinsicInterior n M) where
  eq_of_smul_eq_smul {g g'} h := eq_of_smul_eq_smul (α := M) fun x => congr_fun
    ((continuous_const_smul g).ext_on dense_intrinsicInterior (continuous_const_smul g')
      fun y hy => congr_arg Subtype.val (h ⟨y, hy⟩)) x

end HSP
